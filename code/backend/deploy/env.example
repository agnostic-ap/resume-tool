# --- Server ---
HOST=0.0.0.0
PORT=8787
# debug | info | warn | error
LOG_LEVEL=info
NODE_ENV=production

# --- Persistence (SQLite) ---
# Directory holding resume.db (+ WAL/SHM files). Mount a volume over this path.
RESUME_BACKEND_DATA_DIR=/data

# --- CORS ---
# Comma-separated browser origins allowed to call this API.
# With NODE_ENV=production and this unset, all cross-origin requests are rejected.
CORS_ORIGIN=https://replace-me-with-your-frontend.example.com

# --- Accounts / sessions ---
# Unset = single-user local mode (all data under the local-owner workspace, no login).
# multi-user = /api/* data routes require a logged-in session.
RESUME_AUTH_MODE=multi-user
# Set to false to close self-serve registration (default: true).
RESUME_AUTH_ALLOW_REGISTRATION=true
# Session lifetime in days (default: 30).
RESUME_SESSION_TTL_DAYS=30

# --- Admin console access ---
# JSON array. Prefer tokenHash (sha256 hex of the token) over plaintext token.
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('the-secret').digest('hex'))"
# RESUME_ADMIN_USERS=[{"email":"owner@example.com","tokenHash":"<sha256-hex>","role":"super_admin"}]
# Legacy single super-admin token (ignored when RESUME_ADMIN_USERS is set).
# RESUME_ADMIN_TOKEN=replace-me-admin-token

# --- Platform API clients (B2B server-to-server) ---
# JSON array. Prefer keyHash (sha256 hex) over plaintext key.
# RESUME_PLATFORM_CLIENTS=[{"id":"client-a","keyHash":"<sha256-hex>","scopes":["drafts:write","requests:read"],"quotaPerDay":1000,"rateLimitPerMinute":60,"pricePerDraft":0.5,"currency":"USD"}]
# Legacy single key (replaced by RESUME_PLATFORM_CLIENTS when set).
# RESUME_PLATFORM_API_KEY=replace-me-platform-key

# --- LLM draft generation (optional) ---
# When unset, JD tailoring falls back to the deterministic rule-based engine.
# RESUME_LLM_API_KEY=replace-me-llm-key
# RESUME_LLM_BASE_URL=https://api.openai.com/v1
# RESUME_LLM_MODEL=gpt-4o-mini
# RESUME_LLM_TIMEOUT_MS=20000
